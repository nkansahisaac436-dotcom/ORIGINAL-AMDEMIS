{
  "expo": {
    "name": "AMDEMIS",
    "slug": "amdemis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/coat_of_arms.png",
    "scheme": "amdemis",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/coat_of_arms.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2A66"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gh.gov.amdemis.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/coat_of_arms.png",
        "backgroundColor": "#0A2A66"
      },
      "package": "gh.gov.amdemis.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/coat_of_arms.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://your-project.supabase.co",
      "supabaseAnonKey": "your-anon-key"
    }
  }
}
